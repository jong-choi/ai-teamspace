# infra/verification/compose.yaml 전용 값이다. 이 파일을 같은 디렉터리의 .env로 복사하고 비밀번호를 바꾼다.
# 비어 있는 비밀번호가 있으면 docker compose가 시작하지 않는다.

# host loopback에 여는 port다. 테스트 실행 환경의 DATABASE_URL·REDIS_QUEUE_URL·NEO4J_URI와 맞춘다.
VERIFICATION_POSTGRES_PORT=45432
VERIFICATION_REDIS_PORT=46380
VERIFICATION_NEO4J_BOLT_PORT=47687
VERIFICATION_NEO4J_HTTP_PORT=47474

# `openssl rand -hex 16`처럼 무작위 값을 쓴다. Neo4j 비밀번호는 8자 이상이어야 한다.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
