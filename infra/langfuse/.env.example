# infra/langfuse/compose.yaml 전용 값이다. 이 파일을 같은 디렉터리의 .env로 복사하고 모든 secret을 바꾼다.
# 비어 있는 secret이 있으면 docker compose가 시작하지 않는다.

# host loopback에 여는 port다. Langfuse UI·API와 media upload용 MinIO API.
LANGFUSE_WEB_PORT=3300
LANGFUSE_MINIO_PORT=3390

# `openssl rand -hex 32`처럼 충분히 긴 무작위 값을 쓴다. ENCRYPTION_KEY는 정확히 64자리 hex여야 한다.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# 시작 시 만드는 로컬 프로젝트 API key와 첫 사용자다.
# server/.env의 LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY와 evals/agent/.env의 EVAL_LANGFUSE_*에 같은 key를 넣는다.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-me
LANGFUSE_INIT_USER_EMAIL=admin@localhost.test
LANGFUSE_INIT_USER_PASSWORD=

# 평가기(LLM-as-a-judge)가 판정 모델을 동시에 부르는 수다. 판정 모델 연결은 Langfuse 프로젝트 설정의 LLM Connections에 등록한다.
LANGFUSE_EVAL_EXECUTION_WORKER_CONCURRENCY=1
