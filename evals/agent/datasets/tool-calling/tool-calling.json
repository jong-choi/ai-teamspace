    {
      "id": "ticket-create-with-due",
      "version": "1.0.0",
      "tags": ["tool-calling", "write", "projects", "screen", "datetime"],
      "input": [
        "이 프로젝트 Todo 컬럼에 '결제 오류 문구 수정' 티켓을 높은 우선순위로 만들어줘. 마감은 10월 20일 오후 6시야."
      ],
      "persona": "seeded-owner",
      "organization_fixture": "org",
      "client_context": {
        "time_zone": "Asia/Seoul",
        "route": "/projects/[projectId]",
        "params": {
          "projectId": "$project:app"
        }
      },
      "preconditions": [
        {
          "kind": "project",
          "alias": "app",
          "values": {
            "name": "귤밭 앱 리뉴얼"
          }
        }
      ],
      "expected_tools": {
        "mode": "ordered",
        "tools": ["project_columns_list", "project_ticket_create"]
      },
      "forbidden_tools": [],
      "argument_assertions": [
        {
          "tool": "project_ticket_create",
          "path": "title",
          "operator": "exact",
          "value": "결제 오류 문구 수정"
        },
        {
          "tool": "project_ticket_create",
          "path": "priority",
          "operator": "exact",
          "value": "high"
        },
        {
          "tool": "project_ticket_create",
          "path": "projectId",
          "operator": "exact",
          "value": "$project:app"
        },
        {
          "tool": "project_ticket_create",
          "path": "organizationId",
          "operator": "exact",
          "value": "$organization:org"
        },
        {
          "tool": "project_ticket_create",
          "path": "dueAt",
          "operator": "one_of",
          "value": [
            "2026-10-20T18:00:00+09:00",
            "2026-10-20T18:00:00.000+09:00",
            "2026-10-20T09:00:00Z",
            "2026-10-20T09:00:00.000Z"
