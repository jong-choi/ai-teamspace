COMPOSE_PROJECT_NAME=monorepo-erp

POSTGRES_DB=monorepo_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

REDIS_QUEUE_PORT=6380
REDIS_CACHE_PORT=6381

# Garage(S3 호환 object storage). RPC secret과 secret key는 hex 64자(openssl rand -hex 32),
# access key ID는 GK로 시작하는 26자(GK + hex 24자)여야 한다.
GARAGE_S3_PORT=3900
GARAGE_BUCKET=monorepo-erp
GARAGE_ACCESS_KEY_ID=GKreplace-me
GARAGE_SECRET_ACCESS_KEY=replace-me
GARAGE_RPC_SECRET=replace-me
