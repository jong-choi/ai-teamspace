DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_erp
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# BullMQ 전용 Redis. application cache Redis와 별도 인스턴스를 사용한다.
REDIS_QUEUE_URL=redis://localhost:6380
# application cache 전용 Redis. BullMQ queue Redis와 별도 인스턴스를 사용한다.
REDIS_CACHE_URL=redis://localhost:6381
# Wiki Yjs/Hocuspocus 공동편집 전용 Redis. queue/cache와 공유하지 않는다.
REDIS_COLLABORATION_URL=redis://localhost:6382
# BullMQ가 Redis key namespace에 사용하는 prefix다.
BULLMQ_PREFIX=work-os

COLLABORATION_PORT=3002
COLLABORATION_PUBLIC_URL=ws://localhost:3002
COLLABORATION_JWT_SECRET=replace-with-a-random-collaboration-secret-at-least-32-characters
