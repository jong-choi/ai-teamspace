# compose.env에 두는 값이다. 실제 값은 Git에서 제외된 .temp/deploy-demo에 보관한다.
POSTGRES_PASSWORD=replace-with-a-demo-database-password
NEO4J_PASSWORD=replace-with-a-demo-neo4j-password
GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_ACCESS_KEY_ID=GKreplace-with-24-hex-characters
GARAGE_SECRET_ACCESS_KEY=replace-with-64-hex-characters

# web.env에 두는 공개 데모 빌드 설정이다. 데모 계정 정보는 웹 번들에 포함된다.
EXPO_PUBLIC_API_URL=https://demo.teamspace.jongchoi.com/backend
EXPO_PUBLIC_DEMO_EMAIL=doyun.kim@demo.teamspace
EXPO_PUBLIC_DEMO_PASSWORD=replace-with-a-public-demo-password
EXPO_PUBLIC_DEMO_ORGANIZATION_SLUG=hallabong-studio

# 배포 실행 환경에서 지정한다. 경로는 저장소 기준으로 전달한다.
DEMO_SECRETS_DIR=.temp/deploy-demo
DEMO_IMAGE_TAG=manual
