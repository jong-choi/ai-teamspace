{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@core/*": ["../../src/*"],
      "@repo/client/api-client": [
        "../../../../packages/api-client/src/generated/work-os.ts"
      ],
      "@repo/client/api-client/runtime": [
        "../../../../packages/api-client/src/runtime.ts"
      ],
      "@repo/client/api-client/schemas": [
        "../../../../packages/api-client/src/generated/schemas/index.ts"
      ],
      "@repo/client/api-client/sse": [
        "../../../../packages/api-client/src/sse.ts"
      ],
      "@repo/client/api-client/*": ["../../../../packages/api-client/src/*"],
      "@repo/client/rnr/*": ["../../../../packages/rnr/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/nativewind-env.d.ts"
  ]
}
