# Compose project 이름이다. 같은 이름의 container·network·volume을 한 스택으로 관리한다.
COMPOSE_PROJECT_NAME=ai-teamspace

# 로컬 PostgreSQL 초기 계정·DB와 호스트 포트다. 서버 DATABASE_URL도 같은 값을 사용한다.
POSTGRES_DB=ai_teamspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# 역할별 Redis를 분리하며 아래 값은 호스트 포트다. container 내부 포트는 각각 6379다.
REDIS_QUEUE_PORT=6380
REDIS_CACHE_PORT=6381
# 위키 공동편집용 Redis다. 서버 REDIS_COLLABORATION_URL의 포트와 맞춘다.
REDIS_COLLABORATION_PORT=6382

# compose.local.yaml의 Neo4j 초기 인증 비밀번호다. 서버 NEO4J_PASSWORD와 같은 값을 사용한다.
# 실제 비밀번호는 추적하지 않는 .env에 설정한다.
NEO4J_PASSWORD=replace-with-a-neo4j-password

# Garage(S3 호환 object storage). RPC secret과 secret key는 hex 64자(openssl rand -hex 32),
# access key ID는 GK로 시작하는 26자(GK + hex 24자)여야 한다.
GARAGE_S3_PORT=3900
GARAGE_BUCKET=ai-teamspace
GARAGE_ACCESS_KEY_ID=GKreplace-me
GARAGE_SECRET_ACCESS_KEY=replace-me
GARAGE_RPC_SECRET=replace-me
