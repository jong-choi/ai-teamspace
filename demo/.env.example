# 데모 데이터를 넣을 서버 주소다. 서버가 떠 있어야 한다.
DEMO_API_URL=http://localhost:3200
# 작성 시각을 과거로 옮길 때 쓰는 DB 주소다. 서버의 DATABASE_URL과 같은 DB를 가리킨다.
DEMO_DATABASE_URL=postgresql://postgres:replace-with-a-password@localhost:5432/ai_teamspace
# 의미 그래프 시드가 들어갈 Neo4j다. 서버의 NEO4J_*와 같은 DB를 가리켜야 한다.
DEMO_NEO4J_URI=bolt://localhost:7687
DEMO_NEO4J_USERNAME=neo4j
DEMO_NEO4J_PASSWORD=replace-with-a-password
DEMO_NEO4J_DATABASE=neo4j
# 데모 계정의 비밀번호다. 실제 값은 .env에만 둔다.
DEMO_PASSWORD=replace-with-a-demo-password
# 비우면 실행 시점의 한국 날짜를 기준일로 쓴다. 형식은 YYYY-MM-DD다.
DEMO_BASE_DATE=
