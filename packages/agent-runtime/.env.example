# Durable integration test의 PostgreSQL과 test 전용 Redis namespace다.
# 실제 연결값은 추적하지 않는 .env에 설정한다.
DATABASE_URL=
AGENT_TEST_REDIS_URL=

# 아래 SKEIN 설정은 agent-runtime의 server-kit/CLI에 적용한다.
# 호스트나 CLI가 전달한 명시 옵션이 환경 변수보다 우선하며 비워 둔 선택 변수는 미설정으로 처리한다.

# worker 하나가 동시에 실행할 queued run 수다. 양의 정수이며 기본값은 10이다.
SKEIN_RUN_CONCURRENCY=10
# LangGraph 호환 동시성 변수다. SKEIN_RUN_CONCURRENCY가 비어 있을 때 적용한다. 설정 예시는 10이다.
N_JOBS_PER_WORKER=
# run 실행 시간 상한이다. 단위는 밀리초, 설정 시 양의 정수이며 미설정이면 시간 제한이 없다.
# 예를 들어 5분으로 제한하려면 300000을 설정한다.
SKEIN_RUN_TIMEOUT_MS=
# 종료 시 진행 중인 run을 기다리는 시간이다. 단위는 밀리초, 기본값은 5000이다.
# 0이면 완료를 기다리지 않고 즉시 중단한다. 0 이상의 정수만 허용한다.
SKEIN_SHUTDOWN_GRACE_MS=5000

# Agent Protocol cron 스케줄러의 폴링 간격이다. 단위는 밀리초, 양의 정수, 기본값은 30000이다.
SKEIN_CRON_TICK_MS=30000
# store list/search 한 페이지의 최대 항목 수다. 양의 정수이며 기본값은 1000이다.
# HTTP 계약의 클라이언트 요청 limit 상한은 별도로 1000이므로 이 값만 늘려도 함께 바뀌지 않는다.
SKEIN_MAX_PAGE_SIZE=1000

# 메모리 이벤트 버스가 재접속 replay를 위해 보관할 종료된 run 수다. 양의 정수, 기본값은 50이다.
SKEIN_MEMORY_BUS_MAX_RETAINED_RUNS=50
# run 하나에 보관할 최대 frame 수다. 양의 정수, 기본값은 10000이며 초과 시 가장 오래된 frame부터 제거한다.
SKEIN_MEMORY_BUS_MAX_FRAMES_PER_RUN=10000

# heap 사용률 확인 간격이다. 단위는 밀리초, 양의 정수, 기본값은 30000이다.
SKEIN_HEAP_SAMPLE_MS=30000
# heap 경고 기준 비율이다. 0~100의 정수, 기본값은 85이며 0이면 경고 모니터를 끈다.
SKEIN_HEAP_WARN_PERCENT=85

# webhook 서명용 선택적 secret이다. 비우고 별도 서명 설정도 없으면 unsigned callback을 보낸다.
# 여러 회전 키는 쉼표로 구분하며 환경 변수가 langgraph.json의 secret보다 우선한다.
SKEIN_WEBHOOK_SECRET=
# webhook POST의 대기 상한이다. 단위는 밀리초, 양의 정수, 기본값은 5000이다.
# 수신 서버가 느려 값을 늘릴 때는 SKEIN_SHUTDOWN_GRACE_MS도 함께 늘린다.
SKEIN_WEBHOOK_TIMEOUT_MS=5000
