# 실행 모드다. development, test, production 중 하나이며 기본값은 development다.
# production에서는 외부 MCP OAuth callback이 HTTPS여야 하고 private network 접근을 허용할 수 없다.
NODE_ENV=development

# Application DB와 Agent Protocol resource/checkpoint가 함께 사용하는 PostgreSQL 연결이다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_erp
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
APP_TRUSTED_ORIGINS=http://localhost:8082,monorepoerp://
PORT=3100
# API·공동편집 Node 서버의 전체 요청 헤더 한도다.
NODE_OPTIONS=--max-http-header-size=524288

# Work OS MCP의 OAuth protected resource identifier와 실제 transport URL은 이 값 하나를 사용한다.
MCP_RESOURCE_URL=http://127.0.0.1:3100/mcp
# MCP HTTP Host/Origin 검증에 사용하는 exact allowlist다.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_ALLOWED_ORIGINS=127.0.0.1,localhost
MCP_MAX_REQUEST_BODY_BYTES=104857
MCP_MAX_TOOL_INPUT_ELEMENTS=1000
MCP_REQUEST_TIMEOUT_MS=30000
# Personal MCP Access Key 제품 정책이다. 클라이언트 입력이 아니라 deployment 설정이 기준이다.
MCP_ACCESS_KEY_DEFAULT_EXPIRES_IN_DAYS=30
MCP_ACCESS_KEY_MAX_EXPIRES_IN_DAYS=365
MCP_ACCESS_KEY_MAX_ACTIVE_PER_USER=10
MCP_ACCESS_KEY_RATE_LIMIT_WINDOW_MS=60000
MCP_ACCESS_KEY_RATE_LIMIT_MAX=60
MCP_ACCESS_KEY_OPERATION_RETENTION_HOURS=24
MCP_ACCESS_KEY_RESERVATION_STALE_AFTER_SECONDS=300
# jobs worker가 access key coordination 상태를 정리하는 주기(60~86400초)와 한 번에 조회하는 user 수(1~1000)다.
MCP_ACCESS_KEY_RECONCILIATION_INTERVAL_SECONDS=900
MCP_ACCESS_KEY_RECONCILIATION_BATCH_SIZE=100

# MCP 접근 정책·조직 멤버십을 동기화하는 maintenance 진입점 전용 설정이다.
# TARGETS_JSON은 해당 작업 실행 시 필수이며 []는 처리 대상이 없다는 뜻이다.
# 형식 예시: [{"organizationId":"example-org","userIds":["example-user"]}]
# userIds를 생략하거나 []로 두면 해당 조직의 정책만 동기화한다. 실제 ID는 .env에 설정한다.
MCP_ACCESS_MAINTENANCE_TARGETS_JSON=[]
# 처리할 task의 시작 위치다. 기본값 0이며 이전 결과의 nextCursor로 이어서 실행한다.
MCP_ACCESS_MAINTENANCE_CURSOR=0
# 한 번에 처리할 task 수다. 기본값 100이며 실제 처리 범위는 1~100으로 제한된다.
MCP_ACCESS_MAINTENANCE_LIMIT=100

# MCP delegation과 외부 MCP credential 암호화에 사용하는 AES-256-GCM key ring이다.
CREDENTIAL_ENCRYPTION_CURRENT_KEY_ID=local-v1
CREDENTIAL_ENCRYPTION_KEYS=local-v1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# graph-03 확정 업무 투영은 RDBMS 관계 감사와 통합테스트 통과 후에만 활성화한다.
KG_PROJECTION_ENABLED=false
# Wiki 의미 추출·임베딩은 투영과 공급자 연결 설정이 모두 준비된 Jobs에서만 켠다.
KG_SEMANTIC_ENABLED=false
# 지식 그래프 조회 API를 활성화한다. true면 Neo4j 연결 설정이 필요하다.
KG_QUERY_ENABLED=false
KG_GRAPH_READ_TIMEOUT_MS=3000
KG_SEMANTIC_WORKER_CONCURRENCY=2
# BullMQ 의미 작업 시작 횟수의 분당 상한이다. 실제 공급자 호출은 chunk 수와 validation retry에 따라 늘어난다.
KG_SEMANTIC_PROVIDER_MAX_PER_MINUTE=30
# 지식 그래프 수동 갱신의 사용자·조직별 시간당 영속 접수 한도입니다.
KG_QUOTA_REFRESH_ACTOR_PER_HOUR=30
KG_QUOTA_REFRESH_ORG_PER_HOUR=300
# 의미/하이브리드 검색의 사용자·조직별 분당 embedding 요청 한도입니다.
KG_QUOTA_SEARCH_ACTOR_PER_MINUTE=60
KG_QUOTA_SEARCH_ORG_PER_MINUTE=600
# 조직별 searchable source가 이 값 이하이면 scoped exact vector search를 사용한다.
KG_SEARCH_ENN_MAX_SOURCES=2000
# 조직 지식 그래프 rebuild의 조직별 일일 신규 요청 한도입니다.
KG_QUOTA_REBUILD_ORG_PER_DAY=3
# Gemini Embedding 2 API key. 실제 secret은 .env에만 둔다.
GEMINI_API_KEY=replace-with-a-gemini-api-key
# KG_PROJECTION_ENABLED 또는 KG_QUERY_ENABLED가 true일 때 필수인 Neo4j 연결 설정이다.
# API와 Jobs가 같은 DB를 참조하며 실제 비밀번호는 .env에만 둔다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# BullMQ 전용 Redis. application cache Redis와 별도 인스턴스를 사용한다.
REDIS_QUEUE_URL=redis://localhost:6380
# application cache 전용 Redis. BullMQ queue Redis와 별도 인스턴스를 사용한다.
REDIS_CACHE_URL=redis://localhost:6381
# Wiki Yjs/Hocuspocus 공동편집 전용 Redis. queue/cache와 공유하지 않는다.
REDIS_COLLABORATION_URL=redis://localhost:6382
# BullMQ가 Redis key namespace에 사용하는 prefix다.
BULLMQ_PREFIX=work-os

# Agent durable queue/replay/live fan-out용 Redis다. deployment를 공유해도 아래 namespace는 application queue와 분리한다.
AGENT_REDIS_URL=redis://localhost:6380
AGENT_REDIS_PREFIX=work-os:dev:agent
# DeepAgents root/subagent가 사용할 Ollama model 이름이다.
AGENT_MODEL=gpt-oss:120b
# Ollama Cloud API key. 실제 secret은 .env에만 둔다.
OLLAMA_API_KEY=replace-with-an-ollama-api-key
# Ollama API host. production은 HTTPS, 로컬 개발은 loopback HTTP만 허용한다.
OLLAMA_BASE_URL=https://ollama.com
AGENT_MCP_TOOL_TIMEOUT_MS=30000
AGENT_RUN_QUEUE_NAME=work-os-dev-agent-runs
AGENT_RUN_CONCURRENCY=4
AGENT_RUN_TIMEOUT_MS=300000
AGENT_SHUTDOWN_GRACE_MS=30000
# true면 application bootstrap에서 Agent runtime/PostgresSaver additive migration을 실행한다. 배포 migration을 분리한 환경은 false로 설정한다.
AGENT_MIGRATE_ON_STARTUP=true
AGENT_REPLAY_STREAM_TTL_SECONDS=3600
AGENT_REPLAY_CLOSED_TTL_SECONDS=86400
AGENT_REPLAY_STREAM_MAXLEN=10000
AGENT_REPLAY_SUBSCRIBER_BUFFER_FRAMES=512

# Agent durable integration test는 공용 DATABASE_URL과 test 전용 Redis namespace를 사용한다.
AGENT_TEST_REDIS_URL=
# 로컬 self-hosted Langfuse(infra/langfuse) trace 연결 acceptance 전용이다. 비워 두면 해당 test를 skip한다.
# infra/langfuse/.env의 LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY를 넣는다.
AGENT_TEST_LANGFUSE_BASE_URL=
AGENT_TEST_LANGFUSE_PUBLIC_KEY=
AGENT_TEST_LANGFUSE_SECRET_KEY=

# Agent tracing은 기본 비활성화다. 활성화하면 아래 credential/hash secret이 모두 필요하다.
# 로컬 개발은 infra/langfuse의 self-hosted Langfuse를 쓴다(기본 주소 http://localhost:3300).
# LANGFUSE_BASE_URL은 HTTPS여야 하고, loopback 주소만 HTTP를 허용한다.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3300
LANGFUSE_PUBLIC_KEY=replace-with-a-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-a-langfuse-secret-key
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1
# production 기본은 metadata다. sanitized-content는 명시적으로 필요한 환경에서만 사용한다.
LANGFUSE_CAPTURE_LEVEL=metadata
# raw user/org 식별자를 보내지 않기 위한 HMAC secret이다. UTF-8 기준 최소 32바이트.
LANGFUSE_ID_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# 사용자별 external MCP connection의 server-side OAuth callback URL과 outbound limits다.
AGENT_EXTERNAL_MCP_OAUTH_CALLBACK_URL=http://localhost:3100/agent/mcp/oauth/callback
AGENT_EXTERNAL_MCP_CONNECT_TIMEOUT_MS=10000
AGENT_EXTERNAL_MCP_TOOL_TIMEOUT_MS=30000
AGENT_EXTERNAL_MCP_MAX_RESPONSE_BYTES=1048576
AGENT_EXTERNAL_MCP_MAX_TOOLS_PER_CONNECTION=100
AGENT_EXTERNAL_MCP_MAX_CONNECTIONS_PER_USER=10
# production에서는 반드시 false여야 한다. 로컬 fixture에서만 명시적으로 true를 사용할 수 있다.
AGENT_EXTERNAL_MCP_ALLOW_PRIVATE_NETWORKS=false

COLLABORATION_PORT=3002
COLLABORATION_PUBLIC_URL=ws://localhost:3002
COLLABORATION_JWT_SECRET=replace-with-a-random-collaboration-secret-at-least-32-characters

# 프로필 사진 등 파일을 저장하는 S3 호환 object storage다. 로컬은 compose의 Garage를 쓴다.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_BUCKET=monorepo-erp
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-the-garage-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-the-garage-secret-access-key
