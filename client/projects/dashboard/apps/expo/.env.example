# Native(iOS/Android)는 실행 기기에서 접근 가능한 절대 API 주소가 필수입니다.
# 실제 기기 개발 시 localhost 대신 개발 PC의 LAN IP를 사용하세요.
RCT_METRO_PORT=8082
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# 데모 배포에서만 true로 둔다. true면 로그인하지 않은 방문자를 아래 데모 계정으로 바로 로그인시킨다.
# 값이 클라이언트 번들에 그대로 들어가므로 공개돼도 되는 데모 계정만 쓴다.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
# 자동 로그인 직후에 고를 조직의 slug다. 비우면 내 조직 목록의 첫 번째를 고른다.
EXPO_PUBLIC_DEMO_ORGANIZATION_SLUG=
