{
  "name": "@repo/server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:schema": "auth generate --config ./better-auth.config.ts --adapter drizzle --dialect postgresql --output ./src/auth/infrastructure/persistence/drizzle/generated/auth.schema.ts --yes",
    "build": "nest build",
    "openapi:generate": "npm run build && node dist/openapi.generate.js",
    "db:generate": "npm run auth:schema && drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:jobs": "nest start --entryFile jobs/main",
    "start:jobs:dev": "nest start --entryFile jobs/main --watch",
    "start:jobs:prod": "node dist/jobs/main.js",
    "start:collaboration": "nest start --entryFile wiki/collaboration/main",
    "start:collaboration:dev": "nest start --entryFile wiki/collaboration/main --watch",
    "start:collaboration:prod": "node dist/wiki/collaboration/main.js",
    "wiki:collaboration:cutover": "nest start --entryFile wiki/cutover/main",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs",
    "test:integration": "npm run db:migrate && NODE_OPTIONS=--experimental-vm-modules env-cmd -- jest --config ./jest.config.integration.mjs",
    "test:outbox": "npm run db:migrate && NODE_OPTIONS=--experimental-vm-modules env-cmd -- jest --config ./jest.config.integration.mjs src/outbox/outbox.integration.ts",
    "test:redis": "NODE_OPTIONS=--experimental-vm-modules env-cmd -- jest --config ./jest.config.integration.mjs src/config/cache-redis.integration.ts src/queue/queue.integration.ts",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ./jest.config.mjs --runInBand",
    "test:e2e": "npm run db:migrate && NODE_OPTIONS=--experimental-vm-modules env-cmd -- jest --config ./jest.config.e2e.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/expo": "^1.7.7",
    "@date-fns/tz": "^1.5.0",
    "@hocuspocus/extension-redis": "^4.7.0",
    "@hocuspocus/extension-throttle": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@langchain/mcp-adapters": "2.0.0",
    "@langchain/openai": "1.6.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/outbox": "0.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@repo/agent-runtime": "^0.0.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@touch4it/ical-timezones": "^1.9.0",
    "better-auth": "1.7.7",
    "bullmq": "5.81.5",
    "deepagents": "1.14.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "ical-generator": "^11.1.2",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "langchain": "1.5.10",
    "nest-problem-details-filter": "^1.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@langchain/langgraph-sdk": "1.12.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "env-cmd": "^11.0.0",
    "jest": "^30.5.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.2"
  }
}
