DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_erp
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
APP_TRUSTED_ORIGINS=http://localhost:8082,monorepoerp://
PORT=3100

# BullMQ 전용 Redis. application cache Redis와 별도 인스턴스를 사용한다.
REDIS_QUEUE_URL=redis://localhost:6380
# application cache 전용 Redis. BullMQ queue Redis와 별도 인스턴스를 사용한다.
REDIS_CACHE_URL=redis://localhost:6381
# Wiki Yjs/Hocuspocus 공동편집 전용 Redis. queue/cache와 공유하지 않는다.
REDIS_COLLABORATION_URL=redis://localhost:6382
# BullMQ가 Redis key namespace에 사용하는 prefix다.
BULLMQ_PREFIX=work-os

# Agent Protocol resource/checkpoint용 PostgreSQL 연결이다. 로컬 기본값은 application DB를 함께 사용한다.
AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_erp
# Agent durable queue/replay/live fan-out용 Redis다. deployment를 공유해도 아래 namespace는 application queue와 분리한다.
AGENT_REDIS_URL=redis://localhost:6380
AGENT_REDIS_PREFIX=work-os:dev:agent
# DeepAgents root/subagent가 사용할 LangChain model spec. 현재 dependency에는 OpenAI provider가 포함되어 있다.
AGENT_MODEL=openai:gpt-5-mini
# 실제 WorkOS MCP transport URL. repo-agent에서는 fixture로 검증하고, 최종 credential binding은 next-21 인프라를 재사용한다.
WORKOS_MCP_URL=http://localhost:3100/mcp
AGENT_MCP_TOOL_TIMEOUT_MS=30000
AGENT_RUN_QUEUE_NAME=work-os-dev-agent-runs
AGENT_RUN_CONCURRENCY=4
AGENT_RUN_TIMEOUT_MS=300000
AGENT_SHUTDOWN_GRACE_MS=30000
# true면 application bootstrap에서 Agent runtime/PostgresSaver additive migration을 실행한다. 배포 migration을 분리한 환경은 false로 설정한다.
AGENT_MIGRATE_ON_STARTUP=true
AGENT_REPLAY_STREAM_TTL_SECONDS=3600
AGENT_REPLAY_CLOSED_TTL_SECONDS=86400
AGENT_REPLAY_STREAM_MAXLEN=10000
AGENT_REPLAY_SUBSCRIBER_BUFFER_FRAMES=512

# 사용자별 external MCP connection의 server-side OAuth callback URL과 outbound limits다.
AGENT_EXTERNAL_MCP_OAUTH_CALLBACK_URL=http://localhost:3100/agent/mcp/oauth/callback
AGENT_EXTERNAL_MCP_CONNECT_TIMEOUT_MS=10000
AGENT_EXTERNAL_MCP_TOOL_TIMEOUT_MS=30000
AGENT_EXTERNAL_MCP_MAX_RESPONSE_BYTES=1048576
AGENT_EXTERNAL_MCP_MAX_TOOLS_PER_CONNECTION=100
AGENT_EXTERNAL_MCP_MAX_CONNECTIONS_PER_USER=10
# production에서는 반드시 false여야 한다. 로컬 fixture에서만 명시적으로 true를 사용할 수 있다.
AGENT_EXTERNAL_MCP_ALLOW_PRIVATE_NETWORKS=false

COLLABORATION_PORT=3002
COLLABORATION_PUBLIC_URL=ws://localhost:3002
COLLABORATION_JWT_SECRET=replace-with-a-random-collaboration-secret-at-least-32-characters
