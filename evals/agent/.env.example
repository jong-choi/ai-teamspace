# Target URLs are required by settings; there are no silent localhost defaults.
EVAL_SERVER_URL=http://127.0.0.1:3100
EVAL_MCP_RESOURCE_URL=http://127.0.0.1:3100/mcp
# Must match the ephemeral server's BETTER_AUTH_URL / TrustedOriginGuard allowlist.
EVAL_TRUSTED_ORIGIN=http://localhost:3100
# Required guard. The harness refuses any value other than "ephemeral".
EVAL_TARGET_ENVIRONMENT=ephemeral
# public-http is the real black-box target; deterministic-fixture is PR-fast only.
EVAL_TARGET_ADAPTER=public-http
# Required for any non-loopback target and must exactly confirm its origin.
EVAL_EPHEMERAL_TARGET_ORIGIN=
EVAL_RUN_NAMESPACE=local-agent-eval

EVAL_DATASET=smoke
EVAL_BASELINE=smoke-v1
EVAL_OUTPUT_DIR=.temp/evals/agent/local

EVAL_MAX_CONCURRENCY=4
EVAL_CASE_TIMEOUT_SECONDS=120
EVAL_MAX_TURNS=12
EVAL_MAX_TOOL_CALLS=20
EVAL_MAX_SUBAGENTS=4
EVAL_MAX_COST=5
EVAL_DEEPEVAL_BATCH_SIZE=8
EVAL_DEEPEVAL_ASYNC_MODE=sync
EVAL_TRIALS=1
EVAL_RANDOM_SEED=1

# Optional bearer/session adapter input for a dedicated eval persona.
EVAL_AUTH_BEARER_TOKEN=

# Judge credentials are eval-only. Do not reuse product server env names implicitly.
# The only reviewed provider is ollama-cloud (https://ollama.com, Bearer API key), e.g. EVAL_JUDGE_MODEL=gpt-oss:120b.
# Leave all three empty to run deterministic scoring only.
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=

# Optional Langfuse Observations API linkage. Local runs use the self-hosted Langfuse in infra/langfuse.
EVAL_LANGFUSE_ENABLED=false
EVAL_LANGFUSE_BASE_URL=http://localhost:3300
EVAL_LANGFUSE_PUBLIC_KEY=
EVAL_LANGFUSE_SECRET_KEY=
EVAL_LANGFUSE_PROJECT_ALIAS=
EVAL_LANGFUSE_UI_TRACE_URL_TEMPLATE=
