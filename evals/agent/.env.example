# 평가 대상 URL은 필수다. 비어 있을 때 localhost로 자동 대체하지 않는다.
EVAL_SERVER_URL=http://127.0.0.1:3100
EVAL_MCP_RESOURCE_URL=http://127.0.0.1:3100/mcp
# 평가용 서버의 BETTER_AUTH_URL 및 TrustedOriginGuard 허용 origin과 맞춘다.
EVAL_TRUSTED_ORIGIN=http://localhost:3100
# 필수 대상 환경 표식이다. ephemeral 이외의 값은 harness가 거부한다.
EVAL_TARGET_ENVIRONMENT=ephemeral
# public-http는 실제 서버 평가다. deterministic-fixture는 pr 티어에서만 사용할 수 있다.
EVAL_TARGET_ADAPTER=public-http
# loopback 이외 대상에서는 필수이며 평가 대상의 origin을 정확히 지정해야 한다.
EVAL_EPHEMERAL_TARGET_ORIGIN=
EVAL_RUN_NAMESPACE=local-agent-eval

# 평가 티어다. pr, nightly, release 중 하나이며 기본값은 pr이다.
EVAL_TIER=pr
# 사용할 dataset·baseline 식별자와 저장소 .temp 아래의 평가 결과 경로다.
EVAL_DATASET=smoke
EVAL_BASELINE=smoke-v1
EVAL_OUTPUT_DIR=.temp/evals/agent/local

# 동시 평가 수와 케이스별 실행 한도다. TIMEOUT_SECONDS의 단위는 초다.
EVAL_MAX_CONCURRENCY=4
EVAL_CASE_TIMEOUT_SECONDS=120
EVAL_MAX_TURNS=12
EVAL_MAX_TOOL_CALLS=20
EVAL_MAX_SUBAGENTS=4
EVAL_MAX_COST=5
# DeepEval 배치 크기와 실행 모드(sync 또는 async), 반복 횟수와 난수 seed다.
EVAL_DEEPEVAL_BATCH_SIZE=8
EVAL_DEEPEVAL_ASYNC_MODE=sync
EVAL_TRIALS=1
EVAL_RANDOM_SEED=1

# 전용 평가 계정의 선택적 bearer/session 인증값이다. 실제 값은 .env에만 둔다.
EVAL_AUTH_BEARER_TOKEN=

# 선택 사항이다. 세 값을 모두 채우면 케이스마다 조직을 새로 만들지 않고
# 이미 시드된 워크스페이스(예: 데모 시드)의 기존 계정으로 실행한다.
EVAL_SEEDED_EMAIL=
EVAL_SEEDED_PASSWORD=
EVAL_SEEDED_ORGANIZATION_SLUG=

# Judge 인증은 평가 전용이다. 제품 서버의 환경 변수나 credential을 자동으로 재사용하지 않는다.
# 지원 provider는 ollama-cloud(https://ollama.com, Bearer API key)이며 model 예시는 gpt-oss:120b다.
# 세 값을 모두 비우면 deterministic scoring만 실행한다.
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=

# 선택적 Langfuse Observations API 연결이다. 로컬은 infra/langfuse의 self-hosted 구성을 사용한다.
EVAL_LANGFUSE_ENABLED=false
EVAL_LANGFUSE_BASE_URL=http://localhost:3300
EVAL_LANGFUSE_PUBLIC_KEY=
EVAL_LANGFUSE_SECRET_KEY=
EVAL_LANGFUSE_PROJECT_ALIAS=
EVAL_LANGFUSE_UI_TRACE_URL_TEMPLATE=
# 비동기 trace 수집을 기다리는 최대 시간이다. 단위는 초, 기본값 30, 허용 범위는 0~300이다.
# 0이면 수집 완료를 추가로 기다리지 않는다.
EVAL_LANGFUSE_INGESTION_WAIT_SECONDS=30

# 선택 사항이다. scripts/seeded-round.sh가 server/.env의 키 대신 이 Ollama 키로 평가 서버를 띄운다.
# 평가 트래픽이 제품용 키를 같이 쓰지 않게 한다.
EVAL_SERVER_OLLAMA_API_KEY=
